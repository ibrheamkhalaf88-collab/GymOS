{
    "name": "gymos",
    "version": "1.4.9",
    "type": "module",
    "description": "Digital Pulse",
    "main": "index.html",
    "scripts": {
        "dev": "npx serve -l 5173 .",
        "build:dev": "node scripts/build.js --output dist",
        "build:prod": "node scripts/build.js --output dist --production",
        "sync": "node scripts/sync-www.js",
        "cap:init": "npx cap init",
        "cap:add:android": "npx cap add android",
        "apk": "npm run sync && npx cap sync android && cd android && gradlew.bat assembleDebug",
        "test": "node --test",
        "lint": "eslint ."
    },
    "keywords": [
        "gym",
        "management",
        "pwa",
        "android",
        "firebase"
    ],
    "license": "MIT",
    "dependencies": {
        "@capacitor/android": "^6.2.1",
        "@capacitor/app": "^6.0.3",
        "@capacitor/browser": "^6.0.6",
        "@capacitor/core": "^6.2.1",
        "@supabase/supabase-js": "^2.116.0"
    },
    "devDependencies": {
        "@capacitor/cli": "^6.2.1",
        "@eslint/js": "^10.0.1",
        "autoprefixer": "^10.4.19",
        "cssnano": "^7.0.6",
        "eslint": "^10.9.1",
        "globals": "^17.11.0",
        "jsdom": "^26.1.0",
        "postcss": "^8.4.47",
        "tailwindcss": "^3.4.13",
        "typescript": "^7.0.2"
    }
}
