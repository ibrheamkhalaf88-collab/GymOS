# ============================================================
# Digital Pulse — Production Environment Variables Template
# ============================================================
# انسخ هذا الملف إلى .env.production واملأ القيم الحقيقية
# لا ترفع .env.production إلى Git! (مضاف في .gitignore)
# ============================================================

# ------------------------------------------------------------
# GitHub Repository Secrets (Settings → Secrets → Actions)
# ------------------------------------------------------------
# SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx
#   من: https://supabase.com/account/tokens
#   صلاحيات: Project:read, Functions:write, Secrets:write, Database:read

# SUPABASE_PROJECT_REF=mwfbgucayjgbbvcyelbo
#   معرف مشروعك في Supabase (من URL أو Settings → General)

# SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#   من: Supabase Dashboard → Settings → API → anon public key
#   ⚠️ دوّر هذا المفتاح دورياً (Regenerate) وحدث الـ Secret

# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
#   من: Supabase Dashboard → Settings → API → service_role key
#   ⚠️ سري جداً! لا يظهر في Frontend أبداً

# JWT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   مولد عشوائي 48+ حرف (مثال: openssl rand -base64 48)
#   يستخدم لتوقيع JWT للعميل والأدمن

# ADMIN_PASSWORD=كلمة_سر_قوية_12+_حرف_مع_رموز_وأرقام
#   كلمة سر لوحة الأدمن (ibrheam.html)
#   يجب أن تطابق ما في server/.env و Supabase Function Secrets

# GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
#   من: Google Cloud Console → APIs & Services → Credentials
#   OAuth 2.0 Client ID لـ Google Drive Backup

# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
#   من: نفس مكان Client ID
#   ⚠️ سري!

# CRON_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   مفتاح عشوائي 32+ حرف لـ Cron jobs في drive-backup
#   (مثال: openssl rand -base64 32)

