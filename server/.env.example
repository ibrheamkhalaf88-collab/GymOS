# MongoDB (Atlas free tier or local)
MONGO_URI=mongodb://mongo:27017/gymos

# Auth secrets — غيّرها في الإنتاج (لا تدفع القيم الحقيقية للـ repo)
JWT_SECRET=CHANGE_ME_64_HEX_CHARS_MINIMUM_32_BYTES
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_8_CHARS

PORT=3000

# Web origins allowed by CORS (comma-separated). Android app origins are always allowed.
# ALLOWED_ORIGIN=https://ibrheamkhalaf88-collab.github.io,https://mydomain.com
