{
  "name": "digital-pulse-desktop",
  "version": "1.0.0",
  "description": "Digital Pulse — GymOS desktop app (Electron)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.digitalpulse.gym",
    "productName": "DigitalPulse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "www/**/*"
    ],
    "win": {
      "target": ["portable"],
      "icon": "icon.png"
    }
  }
}
