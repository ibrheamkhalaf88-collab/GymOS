rules_version = '2';

// ============================================================
// GymOS — Firestore Security Rules
//
// المجموعات:
//  codes/{CODE}  : سجل أكواد التفعيل (المعرّف = الكود نفسه)
//  gyms/{CODE}   : بيانات النادي السحابية لصاحب الكود
//
// النموذج:
//  - العميل بدون تسجيل دخول: يقرأ كوداً واحداً بالمعرّف، يفعّله مرة
//    واحدة، ويستطيع تعيين passHash مرة واحدة فقط بعد التفعيل.
//  - gyms: الوصول عبر "معرفة الكود" (مفتاح عشوائي 6 خانات من أبجدية
//    غير ملتبسة ≈ مليار احتمال) — نموذج Capability Token مناسب لهذا
//    الحجم؛ للتشديد مستقبلاً استخدم Cloud Functions + Auth حقيقي.
//  - المدير: تسجيل دخول ببريد adminEmail أدناه.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ ضع بريد المدير هنا (نفس البريد في js/config.js) — يجب أن يكون موثقاً
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "ibrheamshady@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /codes/{codeId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        // تفعيل العميل (حقول محددة فقط، مرة واحدة)
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["used", "usedAt", "usedDevice", "usedDeviceName"])
          && request.resource.data.used == true
          && resource.data.used != true
          && resource.data.revoked != true
        )
        // تعيين أو تغيير كلمة سر الموقع — يتطلب أن يكون الكود مفعّلاً
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["passHash", "passSalt"])
          && resource.data.used == true
          && request.resource.data.passHash is string
          && request.resource.data.passHash.size() == 64
          && request.resource.data.passSalt is string
          && request.resource.data.passSalt.size() == 32
        );
    }

    match /gyms/{codeId} {
      // 🔒 تم إغلاق الوصول المباشر — البيانات عبر API الموثق فقط (JWT)
      // كان سابقاً: allow read,write if codeId.matches(...) — ثغرة حرجة
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}