rules_version = '2';

// ============================================================
// Digital Pulse — Firestore Security Rules
//
// النموذج:
//  - مجموعة codes: كل مستند = كود تفعيل (المعرّف = الكود نفسه XXX-XXX)
//  - العميل (بدون تسجيل دخول): يقرأ كوداً واحداً بالمعرّف فقط، ويستطيع
//    تعديل حقول التفعيل فقط (used/usedAt/usedDevice) وبشرط أن يكون
//    الكود غير مستخدم سابقاً.
//  - المدير: يجب تسجيل الدخول ببريد adminEmail (حدّده أدناه) —
//    له صلاحية إنشاء/حذف/تعديل أي كود وقراءة القائمة كاملة.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ ضع بريد المدير هنا (نفس البريد في js/config.js)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "admin@example.com";
    }

    match /codes/{codeId} {
      // قراءة كود واحد بالمعرّف (لتفعيل العميل) — مسموحة للجميع
      allow get: if true;
      // عرض قائمة كل الأكواد — للمدير فقط
      allow list: if isAdmin();
      // إنشاء وحذف أكواد — للمدير فقط
      allow create, delete: if isAdmin();

      // تعديل:
      //  - المدير يعدّل بحرية
      //  - العميل يستطيع فقط وضع used=true مع بيانات الجهاز،
      //    ولا يمكنه التعديل إذا كان الكود مستخدماً أو موقوفاً
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["used", "usedAt", "usedDevice", "usedDeviceName"])
          && request.resource.data.used == true
          && resource.data.used != true
          && resource.data.revoked != true
        );
    }

    // أي مجموعة أخرى: مرفوضة افتراضياً
    match /{document=**} {
      allow read, write: if false;
    }
  }
}